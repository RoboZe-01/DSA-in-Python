   "source": [
    "1. __init__()\n",
    "\n",
    "- Also known as constructor function \n",
    "- It automatically excecutes without explicit commands \n",
    "- commonly used for data property of oops "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "86c40674",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Temp:\n",
    "    def __init__(self):\n",
    "        print(\"Hello world\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "3389f942",
   "metadata": {},
   "outputs": [
